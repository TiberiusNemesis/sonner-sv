{
	"name": "sonner-sv",
	"version": "0.1.0",
	"description": "An opinionated toast component for Svelte. A Svelte 5 port of Sonner.",
	"keywords": [
		"svelte",
		"sveltekit",
		"notifications",
		"toast",
		"snackbar",
		"message",
		"sonner"
	],
	"author": "TiberiusNemesis (https://github.com/TiberiusNemesis)",
	"license": "MIT",
	"homepage": "https://tiberiusnemesis.github.io/sonner-sv/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TiberiusNemesis/sonner-sv.git"
	},
	"bugs": {
		"url": "https://github.com/TiberiusNemesis/sonner-sv/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && svelte-package",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "playwright test"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"peerDependencies": {
		"svelte": "^5.29.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24.13.6",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"packageManager": "pnpm@11.25.0"
}
